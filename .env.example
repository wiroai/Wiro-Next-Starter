# Copy this file to .env.local and fill it in. Never commit .env.local.

# API key of your Wiro AI project: https://wiro.ai/panel/project
WIRO_API_KEY=

# API secret, only for projects that use signature authentication.
WIRO_API_SECRET=

# Optional. When set, the app asks for this password (any user name works).
BASIC_AUTH_PASSWORD=

# Optional. The most one run may cost, in USD, for example 0.10.
MAX_RUN_PRICE=

# Optional. The largest upload in MB (25 by default).
MAX_UPLOAD_MB=
